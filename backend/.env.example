# Copiar a backend/.env y ajustar. NO committear backend/.env (si va a git).
# Estas variables las lee app/core/config.py (pydantic-settings).

# --- Base de datos (SQLAlchemy async, driver asyncpg) ---
# Local, corriendo uvicorn fuera de Docker contra un Postgres en localhost:
DATABASE_URL=postgresql+asyncpg://practica:practica@localhost:5432/practica
# Dentro de docker-compose el host es el nombre del servicio de la db ("db"):
# DATABASE_URL=postgresql+asyncpg://practica:practica@db:5432/practica

# --- JWT ---
# OBLIGATORIO. No hay default: si falta, la app no arranca.
# Generar uno: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- CORS ---
# Origenes del frontend permitidos, separados por coma (sin espacios).
# Default si no se define: http://localhost:8080,http://localhost:5173
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- WeatherAPI ---
# Obtener la key en https://www.weatherapi.com/ y no committearla.
WEATHER_API_KEY=reemplazar-por-la-key-de-weatherapi
# Opcionales; estos son sus valores por defecto.
WEATHER_API_BASE_URL=https://api.weatherapi.com/v1
WEATHER_API_TIMEOUT_SECONDS=5

# --- Agente Analista (OpenAI, SPEC 06) ---
# Obtener la key en https://platform.openai.com/ y no committearla.
# Si queda vacia, la prediccion con LLM no esta disponible (no se llama a OpenAI).
OPENAI_API_KEY=
# Modelo de chat a usar; sobrescribible por entorno. Default si no se define: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# Opcionales; estos son sus valores por defecto.
OPENAI_TIMEOUT_SECONDS=20
OPENAI_TEMPERATURE=0.2
