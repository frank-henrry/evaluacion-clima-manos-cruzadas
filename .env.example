# Copiar a .env y ajustar si hace falta. docker-compose lo lee automaticamente.
#
# TLS: en local este stack corre en HTTP PLANO, sin cifrado en transito, y es
# aceptable para dev. En cualquier entorno que NO sea local hay que terminar TLS
# por delante (nginx del frontend o reverse proxy). No es tarea del backend.

# --- Frontend ---
# Puerto del host donde queda publicado el frontend.
# Dentro del contenedor nginx siempre escucha en el 80.
FRONTEND_PORT=8080

# URL base del backend de autenticacion. El navegador la usa directo, por eso el
# backend se publica al host. Vite la embebe en tiempo de build: cambiarla
# requiere reconstruir la imagen del frontend.
VITE_API_URL=http://localhost:8000

# --- Backend ---
# Puerto del host donde se publica la API.
BACKEND_PORT=8000

# Secreto de firma JWT (HS256). OBLIGATORIO: sin esto el backend no arranca.
# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRE_MINUTES=60

# Origenes del frontend permitidos por CORS, separados por coma (sin espacios).
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Key privada para consultar current.json de WeatherAPI desde el backend.
WEATHER_API_KEY=reemplazar-por-la-key-de-weatherapi
WEATHER_API_BASE_URL=https://api.weatherapi.com/v1
WEATHER_API_TIMEOUT_SECONDS=5

# --- Base de datos (Postgres) ---
# Credenciales del contenedor de db. El backend arma DATABASE_URL con estos
# valores y se conecta por el nombre de servicio "db" (no localhost).
POSTGRES_USER=practica
POSTGRES_PASSWORD=practica
POSTGRES_DB=practica
